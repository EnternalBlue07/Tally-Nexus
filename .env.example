# =============================================================================
# TALLY NEXUS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Network & Host
PORT=3000
NODE_ENV=development

# Application Base URL (Used for PayPal approval return/cancel redirects)
# Set to your publicly reachable domain (e.g., https://your-app.onrender.com) or local dev URL
APP_BASE_URL=http://localhost:3000

# Persistence & Storage
DATABASE_PATH=./data/tally_nexus.db

# Financial Firewall Constraints
OPERATOR_RESERVE_FLOOR=10.00
OPERATOR_API_KEY=

# PayPal Sandbox Credentials (Required for live PayPal rail execution)
# Obtain from https://developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Commercial / Multi-Model LLM API Keys (Optional: enables live multi-provider AI SLA Judge)
# FreeModel Multi-Model AI Judge (https://freemodel.in)
FREEMODEL_API_KEY=
FREEMODEL_BASE_URL=https://freemodel.in/v1
FREEMODEL_PRIMARY_MODEL=gemini-3.7-flash
FREEMODEL_FALLBACK_MODEL=deepseek-v4.1-flash

# Direct Provider Keys (Alternative: Gemini, Anthropic, OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
