{
  "name": "tally-nexus",
  "version": "0.1.0",
  "description": "Autonomous Agent Clearinghouse & Multilateral SLA-Netting Engine with PayPal Settlement",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/db', { recursive: true }); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql');\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clearinghouse",
    "multilateral-netting",
    "ai-agents",
    "fiduciary-systems",
    "paypal-settlement",
    "ed25519"
  ],
  "author": "Tally Nexus Contributors",
  "license": "MIT",
  "dependencies": {
    "dotenv": "16.4.7",
    "uuid": "11.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "^3.0.7",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
